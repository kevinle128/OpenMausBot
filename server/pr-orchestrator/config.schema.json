                        },
                        "params": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema2"
                          }
                        },
                        "askFirst": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "do"
