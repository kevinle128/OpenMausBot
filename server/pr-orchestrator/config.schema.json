                          "timeZone"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "workflows": {
                "type": "object",
                "properties": {
                  "ciFix": {
                    "type": "object",
                    "properties": {
                      "workflow": {
                        "type": "string",
