                            {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "config": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "config"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "fact": {
                                      "type": "string",
                                      "enum": [
                                        "state",
                                        "previousState",
                                        "draft",
                                        "conflict",
                                        "owner.known",
                                        "pendingDecision",
                                        "run.activeCount",
                                        "trigger.isHead",
                                        "trigger.ci.status",
                                        "trigger.review.status",
                                        "trigger.timer.kind",
                                        "trigger.command.type",
                                        "trigger.command.outcome",
                                        "trigger.command.reason",
                                        "trigger.run.target",
                                        "trigger.run.outcome",
                                        "trigger.answer.kind",
                                        "ci.failingCount",
                                        "review.staleForHead",
                                        "readiness.ready",
                                        "readiness.onlyForgeMissing",
                                        "merge.quietNow",
                                        "merge.minutesToWindow",
                                        "event.branch",
                                        "event.baseRef",
                                        "event.author",
                                        "event.check.source",
                                        "event.check.name",
                                        "event.connector",
                                        "event.type",
                                        "event.subject.kind"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "fact"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "schedule",
                        "afterMinutes"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "cancel": {
                          "type": "string",
                          "enum": [
                            "merge.window",
                            "all"
                          ]
                        }
                      },
                      "required": [
                        "cancel"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "once": {
                "type": "string",
                "enum": [
                  "per-trigger",
                  "per-head",
                  "per-pr"
                ]
              },
              "onceGroup": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "when",
              "then",
              "once"
            ],
            "additionalProperties": false
          }
        },
        "deactivate": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "overrides": {
      "default": [],
      "type": "array",
      "items": {
