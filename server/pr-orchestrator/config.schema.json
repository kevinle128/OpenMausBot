              "name": {
                "type": "string",
                "minLength": 1
              },
              "active": {
                "default": true,
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "when": {
                "type": "object",
                "properties": {
                  "connectors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "providers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "github",
                        "gitlab"
                      ]
                    }
                  },
                  "repos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "on": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "all": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fact": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "state",
                                "previousState",
                                "draft",
                                "conflict",
                                "owner.known",
                                "pendingDecision",
                                "run.activeCount",
                                "trigger.isHead",
                                "trigger.ci.status",
                                "trigger.review.status",
                                "trigger.timer.kind",
                                "trigger.command.type",
                                "trigger.command.outcome",
                                "trigger.command.reason",
                                "trigger.run.target",
                                "trigger.run.outcome",
                                "trigger.answer.kind",
                                "ci.failingCount",
                                "review.staleForHead",
                                "readiness.ready",
                                "readiness.onlyForgeMissing",
                                "merge.quietNow",
                                "merge.minutesToWindow",
                                "event.branch",
                                "event.baseRef",
                                "event.author",
                                "event.check.source",
                                "event.check.name",
                                "event.connector",
                                "event.type",
                                "event.subject.kind"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^config\\.[\\s\\S]{0,}$"
                            },
                            {
                              "type": "string",
                              "pattern": "^event\\.data\\.[\\s\\S]{0,}$"
                            }
                          ]
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "eq",
                            "ne",
                            "lt",
                            "lte",
                            "gt",
                            "gte",
                            "in",
                            "truthy",
                            "falsy"
                          ]
                        },
                        "value": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "config": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "config"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "fact": {
                                      "type": "string",
                                      "enum": [
                                        "state",
                                        "previousState",
                                        "draft",
                                        "conflict",
                                        "owner.known",
                                        "pendingDecision",
                                        "run.activeCount",
                                        "trigger.isHead",
                                        "trigger.ci.status",
                                        "trigger.review.status",
                                        "trigger.timer.kind",
                                        "trigger.command.type",
                                        "trigger.command.outcome",
                                        "trigger.command.reason",
                                        "trigger.run.target",
                                        "trigger.run.outcome",
                                        "trigger.answer.kind",
                                        "ci.failingCount",
                                        "review.staleForHead",
                                        "readiness.ready",
                                        "readiness.onlyForgeMissing",
                                        "merge.quietNow",
                                        "merge.minutesToWindow",
                                        "event.branch",
                                        "event.baseRef",
                                        "event.author",
                                        "event.check.source",
                                        "event.check.name",
                                        "event.connector",
                                        "event.type",
                                        "event.subject.kind"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "fact"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            },
                            {
                              "$ref": "#/$defs/__schema1"
                            }
                          ]
                        }
                      },
                      "required": [
                        "fact",
                        "op"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "on"
                ],
                "additionalProperties": false
              },
              "then": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "do": {
                          "type": "string",
