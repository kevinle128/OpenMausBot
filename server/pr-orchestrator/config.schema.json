{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "connectors": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "use": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "use"
        ],
        "additionalProperties": false
      }
    },
    "readiness": {
      "default": {},
      "type": "object",
      "properties": {
        "requiredChecks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compareBase": {
          "default": true,
          "type": "boolean"
        },
        "requireReview": {
          "default": true,
          "type": "boolean"
        },
        "requireReviewedHead": {
          "default": true,
          "type": "boolean"
        },
        "requireMergeable": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "default": {},
      "type": "object",
      "properties": {
        "auto": {
          "default": true,
          "type": "boolean"
        },
        "method": {
          "default": "squash",
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        },
        "deleteBranch": {
          "default": true,
          "type": "boolean"
        },
        "quietHours": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "timeZone": {
                  "type": "string"
                }
              },
              "required": [
                "start",
                "end",
                "timeZone"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "workflows": {
      "default": {},
      "type": "object",
      "properties": {
        "ciFix": {
          "default": {},
          "type": "object",
          "properties": {
            "workflow": {
              "default": "",
              "type": "string",
              "maxLength": 200
            },
            "connection": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "default": "CI failed on {{repo}}#{{number}} at {{headSha}}: {{failedChecks}}. {{url}}",
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "escalation": {
      "default": {},
      "type": "object",
      "properties": {
        "decision": {
          "default": true,
          "type": "boolean"
        },
        "notifier": {
          "default": "inbox",
          "type": "string",
          "const": "inbox"
        },
        "digestMinutes": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisionChoices": {
          "default": [
            "Fix it as the review proposes",
            "Leave it as it is",
            "Stop and wait for me"
          ],
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": {},
      "type": "object",
      "properties": {
        "newAgent": {
          "default": {},
          "type": "object",
          "properties": {
            "cwd": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "harness": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "default": {},
      "type": "object",
      "properties": {
        "forge": {
          "default": {},
          "type": "object",
          "properties": {
            "github": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "auth": {
                  "default": "app",
                  "type": "string",
                  "enum": [
                    "app",
                    "token"
                  ]
                },
                "apiUrl": {
                  "type": "string"
                },
                "appIdSecret": {
                  "default": "GITHUB_APP_ID",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"
                },
                "privateKeySecret": {
                  "default": "GITHUB_APP_PRIVATE_KEY",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"
                },
                "tokenSecret": {
                  "default": "GITHUB_TOKEN",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"
                }
              },
              "additionalProperties": false
            },
            "gitlab": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "baseUrl": {
                  "type": "string"
                },
                "tokenSecret": {
                  "default": "GITLAB_TOKEN",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "notifier": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "bindOwners": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "default": {},
      "type": "object",
      "properties": {
        "maxAttempts": {
          "default": 6,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWaits": {
          "default": 120,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "backoffSeconds": {
          "default": {},
          "type": "object",
          "properties": {
            "initial": {
              "default": 30,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "default": 1800,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "concurrency": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "messages": {
      "default": {},
      "type": "object",
      "properties": {
        "conflict": {
          "default": "{{repo}}#{{number}} ({{url}}) has a merge conflict at {{headSha}}. Rebase onto or merge the base branch {{baseRef}}, resolve the conflict, and push once.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "decisionAnswered": {
          "default": "The person answered the question about {{repo}}#{{number}} ({{url}}).\nQuestion: {{question}}\nAnswer: {{answer}}\nApply the answer and push once.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "merged": {
          "default": "{{repo}}#{{number}} ({{url}}) is merged as {{mergeSha}}. Continue your work.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "default": {},
      "type": "object",
      "properties": {
        "endedPrDays": {
          "default": 180,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "receivedEventDays": {
          "default": 90,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "routines": {
      "default": {},
      "type": "object",
      "properties": {
        "useDefaults": {
          "default": true,
          "type": "boolean"
        },
        "custom": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
